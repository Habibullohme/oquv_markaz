# Arizalar Telegram'ga yuboriladi.
# 1) @BotFather da /newbot orqali bot yarating va tokenni oling
# 2) Botga (yoki bot qo'shilgan guruhga) biror xabar yozing
# 3) https://api.telegram.org/bot<TOKEN>/getUpdates ochib "chat":{"id":...} ni oling
# Bu faylni .env.local deb nusxalang va qiymatlarni yozing (GitHub'ga yuklanmaydi)
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

# Saytning to'liq manzili (havola ulashilganda rasm va Google uchun). Vercel'da shart emas.
NEXT_PUBLIC_SITE_URL=https://ieltsacademy.uz
